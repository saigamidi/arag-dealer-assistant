# Copy to .env and adjust. .env is git-ignored; never put API keys in it if
# the repo is public. Keep keys in Codespaces secrets instead.

# Retrieval method: vector | hybrid | bm25
# Chosen from evaluation (20 labeled queries): vector 100% chunk hit@3,
# hybrid 90%, bm25 90%. See PRD > Decision Evolution.
RETRIEVER=vector

# Optional overrides (defaults shown)
# AZURE_OPENAI_API_VERSION=2024-10-21
# API_TIMEOUT_SECONDS=5
# MOCK_API_URL=http://localhost:8000
